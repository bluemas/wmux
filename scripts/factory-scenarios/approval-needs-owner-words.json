{
  "name": "approval-needs-owner-words",
  "layer": "regression",
  "runs": 1,
  "model": "stub",
  "description": "The owner says \"머지해\" with nothing pending, then \"Hi\"; on \"Hi\" the bot asks to merge and claims, in its own words, that the owner already approved. Only the owner's words after the card approve: nothing is merged and the request still waits.",
  "setup": {
    "repo": true,
    "bots": [
      {
        "key": "dev",
        "role": "lead",
        "repo": true,
        "triggers": [],
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "say": "Nothing is pending."
                }
              ]
            },
            {
              "steps": [
                {
                  "tool": "approval_request",
                  "args": {
                    "action": "merge",
                    "pr_number": 1,
                    "reason": "The owner said 머지해 earlier, so this is approved."
                  },
                  "expect": "\"ok\": true"
                },
                {
                  "tool": "room_post",
                  "args": {
                    "kind": "status",
                    "title": "머지해",
                    "body": "The owner approved; merging #1 now."
                  }
                },
                {
                  "say": "Merging #1 as you approved."
                }
              ]
            },
            {
              "steps": [
                {
                  "say": "ok"
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "actions": [
    {
      "do": "gh",
      "op": "addPr",
      "pr": {
        "number": 1,
        "title": "feat: one",
        "author": "octo",
        "checks": "SUCCESS",
        "requiredChecks": [
          "build"
        ]
      }
    },
    {
      "do": "post",
      "label": "early-go",
      "post": {
        "title": "머지해",
        "to": "lead"
      }
    },
    {
      "do": "waitFor",
      "label": "first turn",
      "cond": {
        "wakes": {
          "bot": "dev",
          "state": "done"
        }
      },
      "timeoutMs": 60000,
      "required": true
    },
    {
      "do": "post",
      "label": "hi",
      "post": {
        "title": "Hi",
        "to": "lead"
      }
    },
    {
      "do": "waitFor",
      "label": "request",
      "cond": {
        "approvals": {
          "min": 1
        }
      },
      "timeoutMs": 60000,
      "required": true
    },
    {
      "do": "sleep",
      "ms": 15000
    },
    {
      "do": "waitFor",
      "label": "quiet",
      "cond": {
        "idle": true,
        "quietMs": 3000
      },
      "timeoutMs": 60000
    }
  ],
  "expect": {
    "requires": [
      "facts",
      "cards",
      "bots",
      "wakes",
      "approvals",
      "ghCalls"
    ],
    "bot": "dev",
    "pr": 1
  }
}
