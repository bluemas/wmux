{
  "name": "taint-lane-refused",
  "layer": "regression",
  "runs": 1,
  "model": "stub",
  "description": "The lead is woken by an issue (outside text) and starts a default worker; its task carries the taint. The verifier passes the PR with gate evidence and lane auto-merge is on, yet the lane refuses tainted-origin and merges nothing: the owner merges such a PR.",
  "setup": {
    "repo": true,
    "worker": {
      "commit": true,
      "delayMs": 1500
    },
    "bots": [
      {
        "key": "lead",
        "role": "lead",
        "repo": true,
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "capture": {
                    "key": "idempotency_key \"(wake:[^\"]+)\""
                  }
                },
                {
                  "tool": "fanout_start",
                  "args": {
                    "idempotency_key": "{{key}}",
                    "titles": [
                      "feat: add widget"
                    ],
                    "prompt": "Add a widget file to the repository.",
                    "preset": "default"
                  }
                }
              ]
            },
            {
              "steps": [
                {
                  "say": "noted"
                }
              ]
            }
          ]
        },
        "triggers": [
          {
            "kind": "issue.opened"
          }
        ]
      },
      {
        "key": "verifier",
        "role": "verifier",
        "repo": true,
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "capture": {
                    "key": "idempotency_key \"(wake:[^\"]+)\""
                  }
                },
                {
                  "tool": "pr_read",
                  "args": {
                    "pr_number": 1
                  },
                  "save": {
                    "head": "\"head(?:Sha|RefOid)\": \"([0-9a-f]{40})\""
                  }
                },
                {
                  "tool": "fanout_start",
                  "args": {
                    "idempotency_key": "{{key}}",
                    "titles": [
                      "verify PR #1"
                    ],
                    "prompt": "Grade pull request #1 at its head.",
                    "preset": "verify",
                    "checkout": {
                      "sha": "{{head}}",
                      "fetch_ref": "pull/1/head"
                    }
                  }
                }
              ]
            },
            {
              "steps": [
                {
                  "capture": {
                    "task": "\"taskId\": \"(wtask-[^\"]+)\"",
                    "gateHead": "\"headSha\": \"([0-9a-f]{40})\""
                  }
                },
                {
                  "tool": "pr_verdict",
                  "args": {
                    "pr_number": 1,
                    "head_sha": "{{gateHead}}",
                    "verdict": "pass",
                    "summary": "The recorded gate is green at this head.",
                    "evidence": {
                      "task_id": "{{task}}"
                    }
                  }
                }
              ]
            },
            {
              "steps": [
                {
                  "say": "nothing to do"
                }
              ]
            }
          ]
        }
      }
    ],
    "settings": {
      "laneAutoMerge": true
    }
  },
  "actions": [
    {
      "do": "waitFor",
      "label": "repo watch baseline",
      "cond": {
        "repoWatch": {
          "repo": "github.com/acme/app"
        }
      },
      "timeoutMs": 100000,
      "required": true
    },
    {
      "do": "emit",
      "label": "issue",
      "fact": {
        "kind": "issue.opened",
        "repoKey": "{{repoKey}}",
        "ref": {
          "issue": 7
        },
        "actor": {
          "kind": "github"
        },
        "payload": {
          "author": "octo",
          "title": "Add a widget",
          "labels": []
        }
      }
    },
    {
      "do": "waitFor",
      "label": "worker pushed its branch",
      "cond": {
        "workers": {
          "event": "commit"
        }
      },
      "timeoutMs": 180000,
      "required": true
    },
    {
      "do": "gh",
      "op": "addPr",
      "fromBranch": "wtask/",
      "pr": {
        "number": 1,
        "title": "feat: add widget",
        "author": "octo",
        "checks": "SUCCESS",
        "requiredChecks": [
          "build"
        ]
      }
    },
    {
      "do": "waitFor",
      "label": "pr.opened",
      "cond": {
        "facts": {
          "kind": "pr.opened"
        }
      },
      "timeoutMs": 100000
    },
    {
      "do": "waitFor",
      "label": "verdict recorded",
      "cond": {
        "facts": {
          "kind": "verdict.recorded"
        }
      },
      "timeoutMs": 300000
    },
    {
      "do": "waitFor",
      "label": "lane outcome",
      "cond": {
        "facts": {
          "kind": "merge.refused"
        }
      },
      "timeoutMs": 120000
    },
    {
      "do": "waitFor",
      "label": "quiet",
      "cond": {
        "idle": true,
        "quietMs": 3000
      },
      "timeoutMs": 60000
    }
  ],
  "expect": {
    "requires": [
      "facts",
      "cards",
      "bots",
      "wakes",
      "ledger",
      "verdicts",
      "ghCalls",
      "workers"
    ],
    "pr": 1,
    "verifier": "verifier",
    "lead": "lead"
  }
}
