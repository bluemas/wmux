{
  "name": "coordinator-room-wakes-lead-only",
  "layer": "regression",
  "runs": 1,
  "model": "stub",
  "description": "In a room with an enabled coordinator, the owner posts to the room with no bot named: only the coordinator wakes (one directed fact, a direct wake without the room flag), the other bots stay asleep, and the card names the coordinator as its one addressee.",
  "setup": {
    "bots": [
      {
        "key": "lead",
        "template": "coordinator",
        "triggers": [],
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "tool": "room_post",
                  "args": {
                    "kind": "opinion",
                    "title": "On it",
                    "body": "I will pick who works on this."
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "key": "developer",
        "template": "developer",
        "triggers": [],
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "tool": "room_post",
                  "args": {
                    "kind": "opinion",
                    "title": "Hi from developer",
                    "body": "developer here."
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "key": "issue",
        "template": "issue",
        "triggers": [],
        "script": {
          "turns": [
            {
              "steps": [
                {
                  "tool": "room_post",
                  "args": {
                    "kind": "opinion",
                    "title": "Hi from issue",
                    "body": "issue here."
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "actions": [
    {
      "do": "post",
      "label": "hi",
      "post": {
        "title": "Hi team",
        "body": "Can someone look at the login bug?"
      }
    },
    {
      "do": "waitFor",
      "label": "lead answered",
      "cond": {
        "wakes": {
          "bot": "lead",
          "reason": "human",
          "state": "done"
        }
      },
      "timeoutMs": 60000,
      "required": true
    },
    {
      "do": "waitFor",
      "label": "quiet",
      "cond": {
        "idle": true,
        "quietMs": 5000
      },
      "timeoutMs": 30000
    }
  ],
  "expect": {
    "requires": [
      "facts",
      "cards",
      "bots",
      "wakes"
    ],
    "message": "hi",
    "lead": "lead",
    "silent": [
      "developer",
      "issue"
    ]
  }
}
